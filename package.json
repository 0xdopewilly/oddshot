{
  "name": "oddshot",
  "version": "1.7.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "pnpm": "11.11.0"
  },
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node24 --minify --outfile=dist/plugin.mjs",
    "conformance": "node scripts/conformance.mjs",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit",
    "build:pro": "test -n \"$ODDSHOT_PRO_URL\" && esbuild src/main.ts --bundle --platform=node --format=esm --target=node24 --minify --define:process.env.ODDSHOT_PRO_URL=\\\"$ODDSHOT_PRO_URL\\\" --outfile=dist/plugin.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "ajv": "8.20.0"
  }
}
